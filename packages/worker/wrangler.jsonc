// The Worker's public configuration (DATA-2): bindings, migrations and observability only. Deployment values (account,
// routes, custom domains, the database and bucket identifiers, the variables of design.md section 11) live in the
// gitignored wrangler.deploy.jsonc; local development takes the variables from .dev.vars (see .dev.vars.example).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-10",
  // The Worker is reached only on its routes: no workers.dev URL and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Metadata (design.md section 3).
  "d1_databases": [{ "binding": "DB", "migrations_dir": "migrations" }],
  // File bytes, one object per distinct file per artifact (design.md section 3).
  "r2_buckets": [{ "binding": "FILES" }],
  // The gallery's stylesheets, fonts and icon are bundled with the Worker: stylesheets and the SVG icon as text, fonts
  // and the ICO icon as bytes. fallthrough: true keeps wrangler's default rules (.txt, .html, .sql as text; .bin as
  // data) after these; nothing here imports such files, so false says the defaults are not needed and silences the
  // warning about them.
  "rules": [
    { "type": "Text", "globs": ["**/*.css", "**/*.svg"], "fallthrough": false },
    { "type": "Data", "globs": ["**/*.woff2", "**/*.ico"], "fallthrough": false },
  ],
  // Console output is kept. Invocation logs are off: they record the request, and API requests carry bearer tokens in
  // their Authorization header.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
  },
}
